{
  "name": "decky-grip",
  "version": "0.2.1",
  "description": "Resume Steam Community Guides exactly where you left off on Steam Deck.",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "pnpm run test:frontend && pnpm run test:backend",
    "test:frontend": "vitest run tests/typescript",
    "test:backend": "python3 -m unittest discover -s tests/python -p 'test_*.py'",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marsevilspirit/decky-grip.git"
  },
  "keywords": [
    "decky",
    "steam-deck",
    "steam-guides",
    "scroll-restoration"
  ],
  "author": "marsevilspirit",
  "license": "BSD-3-Clause",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "bugs": {
    "url": "https://github.com/marsevilspirit/decky-grip/issues"
  },
  "homepage": "https://github.com/marsevilspirit/decky-grip#readme",
  "devDependencies": {
    "@decky/rollup": "1.0.2",
    "@decky/ui": "4.11.0",
    "@rollup/rollup-linux-x64-musl": "4.53.3",
    "@types/webpack": "5.28.5",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "prettier": "3.9.6",
    "rollup": "4.53.3",
    "typescript": "5.6.2",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@decky/api": "1.1.3",
    "tslib": "2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
